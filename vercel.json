  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/render?path=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/render?path=/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/render?path=/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/render?path=/llms-full.txt"
    },
    {
      "source": "/mcp-registry.json",
      "destination": "/api/render?path=/mcp-registry.json"
    },
    {
      "source": "/api/servers.json",
      "destination": "/api/render?path=/api/servers.json"
    },
    {
      "source": "/servers/:slug",
      "destination": "/api/render?path=/servers/:slug"
    },
    {
      "source": "/categories/:slug",
      "destination": "/api/render?path=/categories/:slug"
    },
    {
      "source": "/pillars/:slug",
      "destination": "/api/render?path=/pillars/:slug"
    },
    {
      "source": "/compare/:slug",
      "destination": "/api/render?path=/compare/:slug"
    },
    {
      "source": "/topics/:slug",
      "destination": "/api/render?path=/topics/:slug"
    },
    {
      "source": "/glossary/:slug",
      "destination": "/api/render?path=/glossary/:slug"
    },
    {
      "source": "/tools/:slug",
      "destination": "/api/render?path=/tools/:slug"
    },
    {
      "source": "/research/:slug",
      "destination": "/api/render?path=/research/:slug"
    },
    {
      "source": "/",
      "destination": "/api/render?path=/"
    },
    {
      "source": "/:slug",
      "destination": "/api/render?path=/:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.sentry.io https://*.ingest.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "www.mcpserver.in"
        },
        {
          "type": "host",
          "value": "mcpserver.in"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
